CAJAS_API_BASE_URL=https://your-cajas-api.example
CAJAS_MCP_PUBLIC_URL=https://sebit-mcp.com
CAJAS_MCP_TRANSPORT=streamable-http
CAJAS_MCP_LOG_LEVEL=INFO
CAJAS_MCP_PATH=/mcp
CAJAS_MCP_ALLOWED_HOSTS=sebit-mcp.com
CAJAS_MCP_ALLOWED_ORIGINS=https://sebit-mcp.com
CAJAS_API_BEARER_TOKEN=

STACKEXCHANGE_ENABLED=false
STACKEXCHANGE_KEY=
STACKEXCHANGE_SITE=stackoverflow

EXTERNAL_CONTEXT_TIMEOUT=10
EXTERNAL_CONTEXT_CACHE_TTL=3600

CAJAS_HTTP_TIMEOUT=30
CAJAS_HTTP_RETRIES=2
CAJAS_MAX_RECOMMENDATION_RAW_ENTRIES=50
CAJAS_MAX_FILE_BYTES=5242880
CAJAS_MAX_WORKBOOK_SHEETS=10
CAJAS_MAX_IMPORT_ROWS=5000
CAJAS_MAX_IMPORT_COLUMNS=100
CAJAS_MAX_CELL_LENGTH=5000
CAJAS_IMPORT_SESSION_TTL=1800
